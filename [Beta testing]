<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>RNG CALC ROULETTE</title>

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Caveat:wght@600;700&family=Baloo+2:wght@700;800&display=swap" rel="stylesheet">

<style>
  :root{
    --black:#000000;
    --blue:#0a84ff;
    --blue-faint:rgba(10,132,255,0.32);
    --blue-mid:rgba(10,132,255,0.4);
    --blue-soft:rgba(10,132,255,0.5);
    --white:#ffffff;
    --gray:#8e8e93;
    --red:#ff3b30;
    --orange:#ff9500;
    --green:#34c759;
    --card:rgba(255,255,255,0.08);
    --card-soft:rgba(255,255,255,0.06);
    --divider:rgba(255,255,255,0.15);
    --modal-bg:#1c1c1e;
  }

  *{box-sizing:border-box;}

  html,body{
    margin:0;
    padding:0;
  }

  body{
    min-height:100vh;
    background:#000;
    color:var(--white);
    font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;
    -webkit-font-smoothing:antialiased;
    position:relative;
    overflow-x:hidden;
  }

  /* ============================================================
     CALCULATOR BACKGROUND
     ============================================================ */

  body::before{
    content:"";
    position:fixed;
    inset:-5%;
    z-index:-3;

    background:
      radial-gradient(circle at 50% 25%, rgba(10,132,255,0.18), transparent 45%),
      linear-gradient(135deg,#000 0%,#03111d 45%,#000 100%);

    pointer-events:none;
  }

  /* Large calculator keypad/grid */
  body::after{
    content:"";
    position:fixed;
    inset:0;
    z-index:-2;
    pointer-events:none;
    opacity:0.18;

    background:
      /* calculator screen */
      linear-gradient(
        rgba(10,132,255,0.18),
        rgba(10,132,255,0.18)
      ) 50% 8% / 230px 72px no-repeat,

      /* calculator buttons */
      radial-gradient(
        circle,
        rgba(255,255,255,0.18) 0 2px,
        transparent 3px
      ) 0 0 / 58px 58px,

      /* calculator grid */
      linear-gradient(
        rgba(10,132,255,0.10) 1px,
        transparent 1px
      ) 0 0 / 58px 58px,

      linear-gradient(
        90deg,
        rgba(10,132,255,0.10) 1px,
        transparent 1px
      ) 0 0 / 58px 58px;

    mask-image:linear-gradient(
      to bottom,
      transparent 0%,
      black 15%,
      black 85%,
      transparent 100%
    );
  }

  .app{
    max-width:520px;
    margin:0 auto;
    position:relative;
    min-height:100vh;
  }

  .screen{
    display:none;
    flex-direction:column;
    min-height:100vh;
    padding:28px 22px;
  }

  #screen-0{display:flex;}

  .spacer{
    flex:1 1 auto;
  }

  .btn-primary{
    position:relative;
    display:block;
    width:100%;
    min-height:52px;
    padding:10px 16px;
    background:transparent;
    color:#fff;
    border:none;
    border-radius:12px;
    font-family:'Courier New',monospace;
    font-weight:900;
    font-size:1rem;
    letter-spacing:1.5px;
    cursor:pointer;
    user-select:none;
    -webkit-tap-highlight-color:transparent;
    text-shadow:
      0 1px 0 rgba(255,255,255,0.55),
      0 3px 0 rgba(255,255,255,0.16),
      0 8px 14px rgba(0,0,0,0.8);
    transform:translateY(0);
    transition:
      transform 90ms ease-out,
      text-shadow 90ms ease-out,
      opacity 120ms ease;
  }

  .btn-primary::after{
    content:"";
    position:absolute;
    left:12%;
    right:12%;
    bottom:5px;
    height:10px;
    border-radius:50%;
    background:rgba(0,0,0,0.65);
    filter:blur(7px);
    z-index:-1;
    transform:translateY(9px) scaleX(0.82);
    transition:
      transform 90ms ease-out,
      opacity 90ms ease-out;
  }

  .btn-primary:hover{
    text-shadow:
      0 1px 0 rgba(255,255,255,0.65),
      0 4px 0 rgba(255,255,255,0.18),
      0 10px 18px rgba(0,0,0,0.85);
  }

  .btn-primary:active,
  .btn-primary.is-pressed{
    transform:translateY(6px);
    text-shadow:
      0 1px 0 rgba(255,255,255,0.35),
      0 2px 0 rgba(255,255,255,0.08),
      0 3px 5px rgba(0,0,0,0.75);
  }

  .btn-primary:active::after,
  .btn-primary.is-pressed::after{
    transform:translateY(3px) scaleX(0.92);
    opacity:0.35;
  }

  .btn-primary:disabled{
    background:transparent;
    color:var(--gray);
    cursor:not-allowed;
    text-shadow:none;
    opacity:0.55;
    transform:none;
  }

  .btn-primary:disabled::after{
    opacity:0;
  }

  .btn-danger{
    background:rgba(255,59,48,0.88);
    color:#fff;
    border:none;
    border-radius:15px;
    padding:16px;
    font-weight:800;
    font-size:1rem;
    width:100%;
    cursor:pointer;
    margin-top:10px;
  }

  .exit-btn,.resign-btn{
    background:none;
    border:none;
    color:var(--red);
    font-weight:800;
    font-size:0.72rem;
    letter-spacing:0.5px;
    display:inline-flex;
    align-items:center;
    gap:4px;
    cursor:pointer;
    padding:4px;
  }

  .topbar{
    display:flex;
    align-items:center;
    justify-content:space-between;
    padding:2px 2px 18px;
  }

  .topbar-title{
    font-weight:800;
    font-size:1rem;
  }

  .topbar-spacer{
    width:55px;
  }

  /* ============================================================
     TITLE SCREEN
     ============================================================ */

  .title-rng{
    /* Handwritten/cursive, but still readable */
    font-family:'Caveat',cursive;
    font-weight:700;
    font-size:6.25rem;
    transform:rotate(-4deg) skewX(-5deg);
    text-align:center;
    line-height:0.9;
    margin:0;
    letter-spacing:-1px;
  }

  .title-calc{
    font-family:'Courier New',monospace;
    font-weight:900;
    font-size:3.6rem;
    letter-spacing:-4px;
    text-align:center;
    line-height:1;
    margin:5px 0 0;
  }

  /*
     ROULETTE TITLE

     Instead of having a normal "R", the gun itself forms
     the R. The roulette wheel forms the O.
  */

  .title-roulette-row{
    display:flex;
    align-items:center;
    justify-content:center;
    gap:1px;
    margin-top:8px;
    height:60px;
  }

  .title-gun-r{
    width:52px;
    height:52px;
    flex-shrink:0;
    transform:rotate(0deg);
  }

  .title-wheel-o{
    width:34px;
    height:34px;
    flex-shrink:0;
    margin-left:0;
    margin-right:0;
  }

  .title-ulette{
    font-family:'Baloo 2',sans-serif;
    font-weight:800;
    font-size:2.2rem;
    letter-spacing:-1px;
    line-height:1;
    margin-left:-1px;
  }

  .title-sub{
    font-family:'Courier New',monospace;
    font-size:0.8rem;
    font-weight:700;
    letter-spacing:2px;
    color:var(--gray);
    text-align:center;
    margin-top:16px;
  }

  .title-start-btn{
    letter-spacing:2px;
    font-size:1.05rem;
    min-height:58px;
    margin-top:2px;
  }

  .title-start-btn::before{
    content:"";
    position:absolute;
    left:50%;
    top:50%;
    width:82%;
    height:72%;
    transform:translate(-50%,-50%);
    border-radius:50%;
    background:radial-gradient(
      ellipse,
      rgba(255,255,255,0.08),
      transparent 68%
    );
    filter:blur(10px);
    pointer-events:none;
    z-index:-2;
  }

  .title-start-btn:focus-visible{
    outline:2px solid var(--blue);
    outline-offset:5px;
  }

  .title-footer{
    font-size:0.78rem;
    color:var(--gray);
    text-align:center;
    margin-top:10px;
  }

  /* ============================================================
     SHARED TEXT
     ============================================================ */

  h1.screen-title{
    font-size:1.85rem;
    font-weight:900;
    text-align:center;
    margin:6px 0 2px;
  }

  p.screen-sub{
    color:var(--gray);
    text-align:center;
    margin:0 0 18px;
    font-size:0.9rem;
  }

  /* ============================================================
     PLAYER SETUP
     ============================================================ */

  .segment{
    display:flex;
    background:rgba(255,255,255,0.08);
    border-radius:9px;
    padding:3px;
    margin-bottom:20px;
  }

  .seg-btn{
    flex:1;
    padding:9px 4px;
    border:none;
    background:transparent;
    color:#fff;
    border-radius:7px;
    font-weight:700;
    font-size:0.82rem;
    cursor:pointer;
  }

  .seg-active{
    background:#fff;
    color:#000;
  }

  .field-group{
    margin-bottom:12px;
  }

  .field-group label{
    display:block;
    font-size:0.68rem;
    font-weight:800;
    color:var(--gray);
    letter-spacing:0.6px;
    margin-bottom:5px;
  }

  .field-group input[type=text]{
    width:100%;
    padding:11px 12px;
    border-radius:8px;
    border:1px solid rgba(255,255,255,0.25);
    background:rgba(255,255,255,0.04);
    color:#fff;
    font-size:1rem;
  }

  .field-group input:focus{
    outline:2px solid var(--blue);
    outline-offset:1px;
  }

  /* ============================================================
     RULES
     ============================================================ */

  .rules-scroll{
    overflow-y:auto;
    flex:1;
  }

  .rule{
    margin-bottom:16px;
  }

  .rule-head{
    display:flex;
    align-items:center;
    gap:10px;
    margin-bottom:5px;
  }

  .rule-num{
    width:32px;
    height:32px;
    border-radius:50%;
    background:var(--blue);
    display:flex;
    align-items:center;
    justify-content:center;
    font-weight:800;
    font-size:1rem;
    flex-shrink:0;
  }

  .rule-title{
    font-weight:800;
    font-size:1rem;
  }

  .rule-text{
    color:var(--gray);
    white-space:pre-line;
    margin:0;
    padding-left:42px;
    font-size:0.88rem;
    line-height:1.4;
  }

  .agree-row{
    display:flex;
    align-items:flex-start;
    gap:12px;
    cursor:pointer;
    margin:16px 0;
    background:none;
    border:none;
    color:#fff;
    text-align:left;
    padding:0;
    width:100%;
  }

  .agree-icon{
    font-size:1.35rem;
    line-height:1;
    flex-shrink:0;
  }

  .agree-text{
    font-size:0.86rem;
  }

  /* ============================================================
     COIN FLIP
     ============================================================ */

  .coin-title{
    font-size:1.9rem;
    font-weight:900;
    text-align:center;
  }

  .coin-subtitle{
    font-size:1.35rem;
    font-weight:800;
    text-align:center;
    margin-top:6px;
  }

  .coin-result{
    font-size:1.6rem;
    font-weight:800;
    text-align:center;
    margin-top:16px;
  }

  /* ============================================================
     GAME SCREEN
     ============================================================ */

  .game-topbar{
    display:flex;
    align-items:center;
    justify-content:space-between;
    padding:13px 18px;
    background:rgba(0,0,0,0.5);
    margin:-28px -22px 0;
  }

  .game-topbar .topbar-title{
    font-weight:800;
    font-size:0.95rem;
  }

  .game-content{
    padding:20px 2px;
    overflow-y:auto;
    flex:1;
  }

  .score-bar{
    display:flex;
    gap:8px;
    flex-wrap:wrap;
  }

  .score-card{
    flex:1;
    min-width:68px;
    background:rgba(255,255,255,0.08);
    border-radius:10px;
    padding:8px 4px;
    text-align:center;
  }

  .score-current{
    background:var(--blue-soft);
  }

  .score-name{
    font-size:0.68rem;
    font-weight:800;
  }

  .score-value{
    font-size:1.15rem;
    font-weight:800;
  }

  .resigned-tag{
    font-size:0.5rem;
    font-weight:800;
    color:var(--red);
    display:block;
    margin-top:2px;
  }

  hr.divider{
    border:none;
    border-top:1px solid var(--divider);
    margin:18px 0;
  }

  .section-title{
    font-weight:800;
    font-size:1rem;
    margin-bottom:6px;
  }

  .section-note{
    color:var(--gray);
    font-size:0.85rem;
    margin:0 0 10px;
  }

  .row-card{
    display:flex;
    justify-content:space-between;
    align-items:center;
    background:rgba(255,255,255,0.06);
    border-radius:8px;
    padding:12px;
    margin-bottom:8px;
  }

  .guess-value{
    font-weight:800;
    font-size:1.05rem;
  }

  .dash{
    color:var(--gray);
  }

  .already-guessed{
    font-size:0.76rem;
    color:var(--orange);
    margin-top:4px;
  }

  .turn-title{
    font-size:1.3rem;
    font-weight:800;
    margin-bottom:12px;
  }

  .guess-row{
    display:flex;
    gap:8px;
  }

  .guess-row input{
    flex:1;
    min-width:0;
    padding:11px;
    border-radius:8px;
    border:1px solid rgba(255,255,255,0.25);
    background:rgba(255,255,255,0.04);
    color:#fff;
    font-size:1rem;
  }

  .guess-row button{
    background:var(--blue);
    color:#fff;
    border:none;
    border-radius:8px;
    padding:0 18px;
    font-weight:800;
    cursor:pointer;
    font-size:0.9rem;
  }

  .game-message{
    color:var(--orange);
    font-weight:700;
    text-align:center;
    margin-top:10px;
    font-size:0.86rem;
    min-height:1.1em;
  }

  .history-card{
    background:rgba(255,255,255,0.06);
    border-radius:10px;
    padding:14px;
    margin-bottom:12px;
  }

  .history-header{
    display:flex;
    justify-content:space-between;
    font-weight:800;
    margin-bottom:8px;
    font-size:0.95rem;
  }

  .history-row{
    display:flex;
    justify-content:space-between;
    font-size:0.78rem;
    padding:2px 0;
  }

  .bold{
    font-weight:800;
  }

  /* ============================================================
     ROULETTE
     ============================================================ */

  .roulette-label{
    font-size:1.3rem;
    font-weight:900;
    text-align:center;
    margin-bottom:18px;
  }

  .wheel-wrap{
    width:min(320px,78vw);
    height:min(320px,78vw);
    margin:0 auto;
    position:relative;
  }

  .wheel-guess-label{
    fill:#fff !important;
    font-weight:900 !important;
    filter:drop-shadow(0 0 4px rgba(255,255,255,0.95));
  }

  .wheel-target-label{
    fill:#fff !important;
    font-weight:900 !important;
    filter:drop-shadow(0 0 7px rgba(255,255,255,1));
  }

  /* Fixed pointer: stays still while the wheel spins underneath it. */
  .wheel-pointer{
    position:absolute;
    top:-13px;
    left:50%;
    width:0;
    height:0;
    transform:translateX(-50%);
    border-left:13px solid transparent;
    border-right:13px solid transparent;
    border-top:22px solid #fff;
    filter:drop-shadow(0 2px 3px rgba(0,0,0,0.7));
    z-index:10;
    pointer-events:none;
  }

  #wheel-rotator{
    width:100%;
    height:100%;
    transform:rotate(0deg);
  }

  .spinning-text{
    text-align:center;
    font-family:'Courier New',monospace;
    font-weight:900;
    font-size:1.25rem;
    margin-top:20px;
    display:none;
  }

  /* ============================================================
     ROUND RESULTS
     ============================================================ */

  .result-number{
    font-size:4rem;
    font-weight:900;
    font-family:'Courier New',monospace;
    text-align:center;
  }

  .result-row{
    display:flex;
    justify-content:space-between;
    align-items:center;
    background:rgba(255,255,255,0.08);
    border-radius:10px;
    padding:14px;
    margin-bottom:8px;
  }

  .points{
    font-size:1.35rem;
    font-weight:800;
  }

  .score-row{
    display:flex;
    justify-content:space-between;
    padding:6px 6px;
  }

  .caption{
    font-size:0.74rem;
    color:var(--gray);
  }

  /* ============================================================
     WINNER
     ============================================================ */

  .game-over-title{
    font-size:2.4rem;
    font-weight:900;
    text-align:center;
  }

  .winner-title{
    font-size:1.6rem;
    font-weight:800;
    text-align:center;
    margin-top:4px;
  }

  .final-score-card{
    display:flex;
    justify-content:space-between;
    align-items:center;
    gap:8px;
    background:rgba(255,255,255,0.08);
    border-radius:10px;
    padding:12px;
    margin-bottom:8px;
  }

  .winner-highlight{
    background:var(--blue-mid);
  }

  .table-wrap{
    overflow-x:auto;
    margin-top:10px;
    border-radius:10px;
  }

  table{
    border-collapse:collapse;
    width:100%;
    font-size:0.72rem;
    min-width:340px;
  }

  th,td{
    padding:8px 6px;
    text-align:center;
    border-bottom:1px solid var(--divider);
    white-space:nowrap;
  }

  th{
    background:var(--blue-mid);
    font-size:0.66rem;
  }

  .row-alt{
    background:rgba(255,255,255,0.05);
  }

  .total-row{
    background:var(--blue-mid);
    font-weight:800;
  }

  .pts-green{
    color:var(--green);
  }

  .pts-gray{
    color:var(--gray);
  }

  /* ============================================================
     MODALS
     ============================================================ */

  .modal-overlay{
    position:fixed;
    inset:0;
    background:rgba(0,0,0,0.6);
    display:none;
    align-items:center;
    justify-content:center;
    z-index:50;
    padding:20px;
  }

  .modal-box{
    background:var(--modal-bg);
    border-radius:14px;
    padding:20px 20px 0;
    max-width:300px;
    width:100%;
    text-align:center;
  }

  .modal-title{
    font-weight:800;
    font-size:1rem;
    margin-bottom:6px;
  }

  .modal-message{
    color:var(--gray);
    font-size:0.85rem;
    margin-bottom:16px;
  }

  .modal-buttons{
    display:flex;
    border-top:1px solid rgba(255,255,255,0.15);
    margin:0 -20px;
  }

  .modal-buttons button{
    flex:1;
    padding:12px;
    background:none;
    border:none;
    color:var(--blue);
    font-weight:600;
    font-size:0.95rem;
    cursor:pointer;
  }

  .modal-buttons button.destructive{
    color:var(--red);
    font-weight:800;
  }

  .modal-buttons button+button{
    border-left:1px solid rgba(255,255,255,0.15);
  }

  @media(max-width:380px){
    .title-rng{
      font-size:4.9rem;
    }

    .title-calc{
      font-size:2.8rem;
    }

    .title-ulette{
      font-size:1.7rem;
    }

    .title-gun-r{
      width:43px;
      height:43px;
    }

    .title-wheel-o{
      width:29px;
      height:29px;
    }
  }
</style>
</head>

<body>
<div class="app">

  <!-- ============================================================
       SCREEN 0: TITLE
       ============================================================ -->

  <div class="screen" id="screen-0">

    <div class="spacer"></div>

    <!-- Readable handwritten RNG -->
    <div class="title-rng">RNG</div>

    <!-- Calculator-style CALC -->
    <div class="title-calc">CALC</div>

    <!--
         ROULETTE

         Gun = R
         Wheel = O
         ULETTE = remaining letters
    -->
    <div class="title-roulette-row">

      <!-- GLOCK-INSPIRED R -->
      <svg
        class="title-gun-r"
        viewBox="0 0 120 80"
        xmlns="http://www.w3.org/2000/svg"
        aria-label="R"
        style="transform:scaleX(-1);"
      >
        <!-- slide / barrel: muzzle points toward the wheel -->
        <path
          d="M8 18
             H88
             Q98 18 98 26
             V34
             H59
             V39
             H22
             V34
             H8
             Z"
          fill="#fff"
        />

        <!-- slide detail -->
        <path
          d="M18 23 H72 V28 H18 Z"
          fill="#000"
          opacity=".22"
        />

        <!-- front sight -->
        <path
          d="M88 14 H96 V19 H88 Z"
          fill="#fff"
        />

        <!-- Glock-style angled grip -->
        <path
          d="M52 38
             H72
             L84 67
             Q86 73 79 75
             H62
             L48 46
             Q46 39 52 38
             Z"
          fill="#fff"
        />

        <!-- trigger guard -->
        <path
          d="M43 42
             H59
             Q68 42 68 51
             Q68 60 59 62
             H52
             V56
             H58
