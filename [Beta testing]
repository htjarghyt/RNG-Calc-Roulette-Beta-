<script>

/* =====================================================================
   FLOATING BUTTON PRESS FEEDBACK
   ===================================================================== */

document.querySelectorAll('.btn-primary').forEach(btn => {
  const press = () => btn.classList.add('is-pressed');
  const release = () => btn.classList.remove('is-pressed');

  btn.addEventListener('pointerdown', press);
  btn.addEventListener('pointerup', release);
  btn.addEventListener('pointercancel', release);
  btn.addEventListener('pointerleave', release);
  btn.addEventListener('blur', release);
});


/* =====================================================================
   STATE
   ===================================================================== */

const state = {
  screen: 0,
  playerCount: 2,
  playerNames: [
    "Player 1",
    "Player 2",
    "Player 3",
    "Player 4"
  ],
  activePlayers: [
    true,
    true,
    true,
    true
  ],
  firstPlayer: 0,
  currentPlayer: 0,
  targetNumber: 0,
  coinResult: "",
  currentGuesses: [
    null,
    null,
    null,
    null
  ],
  scores: [
    0,
    0,
    0,
    0
  ],
  rounds: [],
  revealedRound: null,
  pendingRound: null,
  message: "",
  winner: "",
  agreedToRules: false,
  wheelRotation: 0,
  isSpinning: false,
};


/* =====================================================================
   HTML ESCAPING
   ===================================================================== */

function escapeHtml(str){
  return String(str).replace(
    /[&<>"']/g,
    c => ({
      '&':'&amp;',
      '<':'&lt;',
      '>':'&gt;',
      '"':'&quot;',
      "'":'&#39;'
    }[c])
  );
}


/* =====================================================================
   SCREEN SWITCHING
   ===================================================================== */

function goTo(n){

  state.screen = n;

  document
    .querySelectorAll('.screen')
    .forEach(el => el.style.display = 'none');

  const el = document.getElementById('screen-' + n);

  el.style.display = 'flex';

  renderScreen(n);
}


function renderScreen(n){

  if(n === 1) renderPlayerSetup();
  else if(n === 2) renderRules();
  else if(n === 3) renderCoinFlip();
  else if(n === 4) renderGame();
  else if(n === 5) renderRoulette();
  else if(n === 6) renderResults();
  else if(n === 7) renderWinner();

}


/* =====================================================================
   RESET / SETUP
   ===================================================================== */

function resetEverything(){

  state.activePlayers = [
    true,true,true,true
  ];

  state.scores = [
    0,0,0,0
  ];

  state.rounds = [];

  state.currentGuesses = [
    null,null,null,null
  ];

  state.message = "";
  state.winner = "";
  state.firstPlayer = 0;
  state.currentPlayer = 0;
  state.targetNumber = 0;
  state.agreedToRules = false;
  state.wheelRotation = 0;
  state.isSpinning = false;
  state.pendingRound = null;
  state.revealedRound = null;
  state.coinResult = "";

}


function cleanPlayerNames(){

  for(let i = 0; i < state.playerCount; i++){

    const n = (
      state.playerNames[i] || ""
    ).trim();

    state.playerNames[i] =
      n ? n : `Player ${i + 1}`;

  }

}


/* =====================================================================
   PLAYER SETUP
   ===================================================================== */

function renderPlayerSetup(){

  const seg =
    document.getElementById(
      'player-count-segment'
    );

  seg.innerHTML =
    [2,3,4]
      .map(n =>
        `<button
          type="button"
          class="seg-btn ${
            state.playerCount === n
              ? 'seg-active'
              : ''
          }"
          onclick="setPlayerCount(${n})"
        >
          ${n} Players
        </button>`
      )
      .join('');

  const fields =
    document.getElementById(
      'player-name-fields'
    );

  let html = '';

  for(let i = 0; i < state.playerCount; i++){

    html += `
      <div class="field-group">

        <label>
          PLAYER ${i + 1}
        </label>

        <input
          type="text"
          value="${escapeHtml(state.playerNames[i])}"
          oninput="updatePlayerName(${i}, this.value)"
          placeholder="Enter player name"
        >

      </div>
    `;

  }

  fields.innerHTML = html;

}


function setPlayerCount(n){

  state.playerCount = n;

  renderPlayerSetup();

}


function updatePlayerName(i,val){

  state.playerNames[i] = val;

}


/* =====================================================================
   RULES
   ===================================================================== */

function toggleAgree(){

  state.agreedToRules =
    !state.agreedToRules;

  renderRules();

}


function renderRules(){

  document.getElementById(
    'agree-check-icon'
  ).innerHTML =
    state.agreedToRules
      ? '&#9989;'
      : '&#11036;';

  document.getElementById(
    'agree-continue-btn'
  ).disabled =
    !state.agreedToRules;

}


function agreeContinue(){

  if(state.agreedToRules){
    startCoinFlip();
  }

}


/* =====================================================================
   COIN FLIP
   ===================================================================== */

function startCoinFlip(){

  state.firstPlayer =
    Math.floor(
      Math.random() * state.playerCount
    );

  state.currentPlayer =
    state.firstPlayer;

  state.coinResult =
    `${state.playerNames[state.firstPlayer]} goes first!`;

  goTo(3);

}


function renderCoinFlip(){

  document.getElementById(
    'coin-result-text'
  ).textContent =
    state.coinResult;

}


/* =====================================================================
   NUMBER GENERATION
   ===================================================================== */

function generateNumber(){

  state.targetNumber =
    1 + Math.floor(
      Math.random() * 100
    );

}


/* =====================================================================
   GAME SCREEN
   ===================================================================== */

function renderGame(){

  let scoreHtml = '';

  for(let i = 0; i < state.playerCount; i++){

    const isCurrent =
      state.currentPlayer === i &&
      state.activePlayers[i];

    scoreHtml += `
      <div class="score-card ${
        isCurrent ? 'score-current' : ''
      }">

        <div class="score-name">
          ${escapeHtml(state.playerNames[i])}

          ${
            !state.activePlayers[i]
              ? '<span class="resigned-tag">RESIGNED</span>'
              : ''
          }

        </div>

        <div class="score-value">
          ${state.scores[i]}
        </div>

      </div>
    `;

  }

  document.getElementById(
    'score-bar'
  ).innerHTML = scoreHtml;


  let curHtml = '';

  for(let i = 0; i < state.playerCount; i++){

    let right;

    if(!state.activePlayers[i]){

      right =
        `<span
          class="resigned-tag"
          style="margin:0;"
        >
          RESIGNED
        </span>`;

    }
    else if(state.currentGuesses[i] !== null){

      right =
        `<span class="guess-value">
          ${state.currentGuesses[i]}
        </span>`;

    }
    else{

      right =
        `<span class="dash">
          &mdash;
        </span>`;

    }

    curHtml += `
      <div class="row-card">
        <span>
          ${escapeHtml(state.playerNames[i])}
        </span>
        ${right}
      </div>
    `;

  }

  document.getElementById(
    'current-round-list'
  ).innerHTML = curHtml;


  const used =
    state.currentGuesses.filter(
      g => g !== null
    );

  document.getElementById(
    'already-guessed'
  ).textContent =
    used.length
      ? `Already guessed: ${used.join(', ')}`
      : '';


  document.getElementById(
    'turn-title'
  ).textContent =
    `${state.playerNames[state.currentPlayer]}'s TURN`;


  const input =
    document.getElementById(
      'guess-input'
    );

  if(input){
    input.value = '';
  }


  document.getElementById(
    'game-message'
  ).textContent =
    state.message;


  const histSection =
    document.getElementById(
      'history-section'
    );

  if(state.rounds.length === 0){

    histSection.style.display = 'none';

  }
  else{

    histSection.style.display = 'block';

    let h = '';

    state.rounds.forEach(
      (round,idx) => {

        h += `
          <div class="history-card">

            <div class="history-header">
              <span>ROUND ${idx + 1}</span>
              <span>Target: ${round.number}</span>
            </div>
        `;

        for(
          let p = 0;
          p < state.playerCount;
          p++
        ){

          const g =
            round.guesses[p];

          h += `
            <div class="history-row">

              <span>
                ${escapeHtml(
                  state.playerNames[p]
                )}
              </span>

              <span>
                ${
                  g !== null
                    ? 'Guess: ' + g
                    : '&mdash;'
                }
              </span>

              <span class="bold">
                +${round.points[p]}
              </span>

            </div>
          `;

        }

        h += '</div>';

      }
    );

    document.getElementById(
      'history-list'
    ).innerHTML = h;

  }

}


/* =====================================================================
   SUBMIT GUESS
   ===================================================================== */

function submitGuess(){

  if(!state.activePlayers[state.currentPlayer]){

    moveToNextActivePlayer();

    renderGame();

    return;
  }


  const raw =
    document.getElementById(
      'guess-input'
    ).value.trim();


  if(
    raw === '' ||
    !/^\d+$/.test(raw)
  ){

    state.message =
      "Enter a valid number.";

    renderGame();

    return;
  }


  const guess =
    parseInt(raw,10);


  if(
    guess < 1 ||
    guess > 100
  ){

    state.message =
      "Your guess must be between 1 and 100.";

    renderGame();

    return;
  }


  const used =
    state.currentGuesses.filter(
      g => g !== null
    );


  if(used.includes(guess)){

    state.message =
      `${guess} has already been guessed. Choose another number.`;

    renderGame();

    return;
  }


  state.currentGuesses[
    state.currentPlayer
  ] = guess;

  state.message = "";


  let allGuessed = true;

  for(
    let p = 0;
    p < state.playerCount;
    p++
  ){

    if(
      state.activePlayers[p] &&
      state.currentGuesses[p] === null
    ){

      allGuessed = false;

      break;
    }

  }


  if(allGuessed){

    prepareRoulette();

    return;
  }


  moveToNextActivePlayer();

  renderGame();

}


/* =====================================================================
   NEXT PLAYER
   ===================================================================== */

function moveToNextActivePlayer(){

  if(
    !state.activePlayers.includes(true)
  ) return;


  let next =
    (state.currentPlayer + 1) %
    state.playerCount;


  while(
    !state.activePlayers[next] ||
    state.currentGuesses[next] !== null
  ){

    next =
      (next + 1) %
      state.playerCount;

  }


  state.currentPlayer = next;


  const already =
    state.currentGuesses.filter(
      g => g !== null
    );


  if(already.length > 0){

    state.message =
      `Already guessed: ${already.join(', ')}`;

  }

}


/* =====================================================================
   RESIGN
   ===================================================================== */

function showResignAlert(){

  document.getElementById(
    'resign-alert-text'
  ).textContent =
    `${state.playerNames[state.currentPlayer]} will no longer be able to take turns.`;

  document.getElementById(
    'resign-alert-overlay'
  ).style.display = 'flex';

}


function hideResignAlert(){

  document.getElementById(
    'resign-alert-overlay'
  ).style.display = 'none';

}


function resignCurrentPlayer(){

  const resigned =
    state.currentPlayer;

  state.activePlayers[resigned] = false;

  state.currentGuesses[resigned] = null;

  state.message =
    `${state.playerNames[resigned]} has resigned.`;


  const remaining = [];

  for(
    let p = 0;
    p < state.playerCount;
    p++
  ){

    if(state.activePlayers[p]){
      remaining.push(p);
    }

  }


  if(remaining.length === 1){

    state.winner =
      state.playerNames[remaining[0]];

    goTo(7);

    return;
  }


  let allRemainingGuessed = true;

  for(const p of remaining){

    if(
      state.currentGuesses[p] === null
    ){

      allRemainingGuessed = false;

      break;
    }

  }


  if(allRemainingGuessed){

    prepareRoulette();

    return;
  }


  let next =
    (resigned + 1) %
    state.playerCount;


  while(
    !state.activePlayers[next] ||
    state.currentGuesses[next] !== null
  ){

    next =
      (next + 1) %
      state.playerCount;

  }


  state.currentPlayer = next;

  renderGame();

}


/* =====================================================================
   EXIT
   ===================================================================== */

function showExitAlert(){

  document.getElementById(
    'exit-alert-overlay'
  ).style.display = 'flex';

}


function hideExitAlert(){

  document.getElementById(
    'exit-alert-overlay'
  ).style.display = 'none';

}


function exitGame(){

  resetEverything();

  goTo(0);

}


/* =====================================================================
   ROULETTE WHEEL
   ===================================================================== */

function buildWheel(){

  const NS =
    "http://www.w3.org/2000/svg";


  const segGroup =
    document.getElementById(
      'wheel-segments'
    );


  for(
    let n = 1;
    n <= 100;
    n++
  ){

    const rect =
      document.createElementNS(
        NS,
        'rect'
      );

    rect.setAttribute(
      'x',
      '153.5'
    );

    rect.setAttribute(
      'y',
      '25.6'
    );

    rect.setAttribute(
      'width',
      '13'
    );

    rect.setAttribute(
      'height',
      '134.4'
    );

    rect.setAttribute(
      'fill',
      n % 2 === 0
        ? 'rgba(255,59,48,0.75)'
        : '#000'
    );

    rect.setAttribute(
      'transform',
      `rotate(${(n - 1) * 3.6} 160 160)`
    );

    segGroup.appendChild(rect);

  }


  const numGroup =
    document.getElementById(
      'wheel-numbers'
    );


  for(
    let n = 1;
    n <= 100;
    n++
  ){

    // Each number is placed at the centre of its 3.6° segment.
    const angle =
      (n - 1) *
      Math.PI /
      50;

    const x =
      160 +
      Math.sin(angle) *
      108.8;

    const y =
      160 -
      Math.cos(angle) *
      108.8;

    const text =
      document.createElementNS(
        NS,
        'text'
      );

    text.setAttribute('x', x.toFixed(2));
    text.setAttribute('y', (y + 3).toFixed(2));
    text.setAttribute('font-size', n >= 100 ? '6.5' : n >= 10 ? '7.2' : '8');
    text.setAttribute('data-number', n);
    text.textContent = n;

    numGroup.appendChild(text);

  }
}


/* =====================================================================
   PREPARE ROULETTE
   ===================================================================== */

function prepareRoulette(){

  const points =
    calculateRoundPoints();


  state.pendingRound = {

    number:
      state.targetNumber,

    guesses:
      state.currentGuesses.slice(),

    points:
      points

  };


  state.isSpinning = true;

  goTo(5);


  const wheel =
    document.getElementById(
      'wheel-rotator'
    );


  wheel.style.transition = 'none';

  wheel.style.transform =
    `rotate(${state.wheelRotation}deg)`;


  void wheel.getBoundingClientRect();


  /*
     Each segment is 3.6°. Segment 1 is already centred directly
     under the fixed top arrow, so rotate by the exact negative
     angle of the generated number.
  */
  const targetAngle =
    -(state.targetNumber - 1) *
    3.6;

  const currentAngle =
    ((state.wheelRotation % 360) + 360) % 360;

  const desiredAngle =
    ((targetAngle % 360) + 360) % 360;

  let alignment =
    desiredAngle - currentAngle;

  if(alignment < 0){
    alignment += 360;
  }

  const spins =
    4 +
    Math.floor(
      Math.random() * 4
    );

  state.wheelRotation +=
    spins * 360 +
    alignment;


  wheel.style.transition =
    'transform 2.5s cubic-bezier(0.15,0.8,0.3,1)';

  wheel.style.transform =
    `rotate(${state.wheelRotation}deg)`;


  renderRoulette();


  setTimeout(() => {

    state.isSpinning = false;

    document.getElementById(
      'spinning-text'
    ).style.display = 'none';


    if(state.pendingRound){

      revealRound(
        state.pendingRound
      );

    }

  },2500);

}


function renderRoulette(){

  document.getElementById(
    'spinning-text'
  ).style.display =
    state.isSpinning
      ? 'block'
      : 'none';

  // Light up every number that a player guessed.
  const guessed = new Set(
    state.currentGuesses.filter(g => g !== null)
  );

  document.querySelectorAll('#wheel-numbers text').forEach(label => {
    const n = Number(label.getAttribute('data-number'));
    label.classList.toggle('wheel-guess-label', guessed.has(n));
    label.classList.toggle(
      'wheel-target-label',
      !state.isSpinning && n === state.targetNumber
    );
  });

}


/* =====================================================================
   SCORING
   ===================================================================== */

function calculateRoundPoints(){

  const roundPoints =
    new Array(
      state.playerCount
    ).fill(0);


  for(
    let p = 0;
    p < state.playerCount;
    p++
  ){

    if(
      !state.activePlayers[p] ||
      state.currentGuesses[p] === null
    ){
      continue;
    }


    const guess =
      state.currentGuesses[p];


    if(
      guess === state.targetNumber
    ){

      roundPoints[p] = 10;

      continue;
    }


    const guessDigits =
      new Set(
        String(guess).split('')
      );


    const targetDigits =
      new Set(
        String(state.targetNumber).split('')
      );


    let matching = 0;


    guessDigits.forEach(
      d => {

        if(targetDigits.has(d)){
          matching++;
        }

      }
    );


    if(matching === 1){

      roundPoints[p] = 1;

    }
    else if(matching >= 2){

      roundPoints[p] = 2;

    }

  }


  if(
    roundPoints.every(
      pt => pt === 0
    )
  ){

    let closestDistance =
      Infinity;

    let closestPlayers = [];


    for(
      let p = 0;
      p < state.playerCount;
      p++
    ){

      if(
        !state.activePlayers[p] ||
        state.currentGuesses[p] === null
      ){
        continue;
      }


      const distance =
        Math.abs(
          state.currentGuesses[p] -
          state.targetNumber
        );


      if(
        distance < closestDistance
      ){

        closestDistance =
          distance;

        closestPlayers = [p];

      }
      else if(
        distance === closestDistance
      ){

        closestPlayers.push(p);

      }

    }


    closestPlayers.forEach(
      p => {
        roundPoints[p] = 1;
      }
    );

  }


  return roundPoints;

}


/* =====================================================================
   REVEAL ROUND
   ===================================================================== */

function revealRound(round){

  state.rounds.push(round);


  for(
    let p = 0;
    p < state.playerCount;
    p++
  ){

    state.scores[p] +=
      round.points[p];

  }


  state.revealedRound =
    round;

  state.pendingRound =
    null;


  for(
    let p = 0;
    p < state.playerCount;
    p++
  ){

    if(
      state.activePlayers[p] &&
      state.scores[p] >= 100
    ){

      state.winner =
        state.playerNames[p];

      goTo(7);

      return;

    }

  }


  goTo(6);

}


/* =====================================================================
   ROUND RESULTS
   ===================================================================== */

function renderResults(){

  const r =
    state.revealedRound;


  if(!r) return;


  document.getElementById(
    'result-number'
  ).textContent =
    r.number;


  let rows = '';


  for(
    let p = 0;
    p < state.playerCount;
    p++
  ){

    const g =
      r.guesses[p];


    rows += `
      <div class="result-row">

        <div>

          <div class="bold">
            ${escapeHtml(
              state.playerNames[p]
            )}
          </div>

          <div class="caption">
            ${
              g !== null
                ? 'Guess: ' + g
                : 'No guess'
            }
          </div>

        </div>

        <div class="points">
          +${r.points[p]}
        </div>

      </div>
    `;

  }


  document.getElementById(
    'result-rows'
  ).innerHTML =
    rows;


  let scoresHtml = '';


  for(
    let p = 0;
    p < state.playerCount;
    p++
  ){

    scoresHtml += `
      <div class="score-row">

        <span>
          ${escapeHtml(
            state.playerNames[p]
          )}
        </span>

        <span class="bold">
          ${state.scores[p]}
        </span>

      </div>
    `;

  }


  document.getElementById(
    'result-scores'
  ).innerHTML =
    scoresHtml;

}


/* =====================================================================
   NEXT ROUND
   ===================================================================== */

function nextRound(){

  state.targetNumber = 0;

  state.currentGuesses =
    new Array(
      state.playerCount
    ).fill(null);

  state.message = "";

  state.revealedRound = null;

  state.pendingRound = null;


  if(
    state.activePlayers[
      state.firstPlayer
    ]
  ){

    state.currentPlayer =
      state.firstPlayer;

  }
  else{

    state.currentPlayer =
      state.activePlayers.findIndex(
        a => a === true
      );

  }


  generateNumber();

  goTo(4);

}


/* =====================================================================
   WINNER
   ===================================================================== */

function renderWinner(){

  document.getElementById(
    'winner-name-text'
  ).textContent =
    `${state.winner} WINS!`;


  let finalHtml = '';


  for(
    let i = 0;
    i < state.playerCount;
    i++
  ){

    const isWinner =
      state.playerNames[i] ===
      state.winner;


    finalHtml += `
      <div class="final-score-card ${
        isWinner
          ? 'winner-highlight'
          : ''
      }">

        <span>
          ${escapeHtml(
            state.playerNames[i]
          )}
        </span>

        ${
          !state.activePlayers[i]
            ? '<span class="resigned-tag" style="margin:0;">RESIGNED</span>'
            : '<span></span>'
        }

        <span class="bold">
          ${state.scores[i]}
        </span>

      </div>
    `;

  }


  document.getElementById(
    'final-scores'
  ).innerHTML =
    finalHtml;


  let header =
    `<tr>
      <th>ROUND</th>
      <th>TARGET</th>`;


  for(
    let p = 0;
    p < state.playerCount;
    p++
  ){

    header += `
      <th>
        ${escapeHtml(
          state.playerNames[p]
        )}
        <br>
        <span style="font-weight:400;">
          Guess / Pts
        </span>
      </th>
    `;

  }


  header += '</tr>';


  let rows = '';


  state.rounds.forEach(
    (round,idx) => {

      rows += `
        <tr class="${
          idx % 2 === 0
            ? 'row-alt'
            : ''
        }">

          <td>${idx + 1}</td>

          <td>${round.number}</td>
      `;


      for(
        let p = 0;
        p < state.playerCount;
        p++
      ){

        const g =
          round.guesses[p];

        const pts =
          round.points[p];


        rows += `
          <td>

            <div class="bold">
              ${
                g !== null
                  ? g
                  : '&mdash;'
              }
            </div>

            <div class="${
              pts > 0
                ? 'pts-green'
                : 'pts-gray'
            }">
              +${pts}
            </div>

          </td>
        `;

      }


      rows += '</tr>';

    }
  );


  let totalRow =
    '<tr class="total-row"><td colspan="2">TOTAL</td>';


  for(
    let p = 0;
    p < state.playerCount;
    p++
  ){

    totalRow += `
      <td>
        ${state.scores[p]}
      </td>
    `;

  }


  totalRow += '</tr>';


  document.getElementById(
    'score-table'
  ).innerHTML =
    `<table>
      ${header}
      ${rows}
      ${totalRow}
    </table>`;

}


/* =====================================================================
   PLAY AGAIN
   ===================================================================== */

function playAgain(){

  resetEverything();

  goTo(2);

}


